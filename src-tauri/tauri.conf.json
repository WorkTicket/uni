{
  "productName": "Universe Engine",
  "version": "0.2.0",
  "identifier": "com.universeengine.app",
  "build": {
    "frontendDist": "../src/universe_engine/observatory/static",
    "devUrl": "http://127.0.0.1:8000",
    "beforeDevCommand": "python -m universe_engine.launcher --no-browser",
    "beforeBuildCommand": "echo 'Building Universe Engine desktop application'",
    "builder": {
      "frontend": [],
      "distDir": "../src/universe_engine/observatory/static"
    }
  },
  "app": {
    "windows": [
      {
        "title": "Universe Engine",
        "width": 1200,
        "height": 800,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "msi",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
